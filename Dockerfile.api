# syntax=docker/dockerfile:1.6
# Multi-stage build for the DataFoundry API server.
# Builds TypeScript, then runs the Node.js HTTP server on a slim base.

FROM node:22.21-bookworm-slim AS builder
WORKDIR /repo

# Install build dependencies for native modules (better-sqlite3).
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 build-essential ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# Copy the whole monorepo so workspace references resolve.
COPY . .

# Build the API and the workspace packages it depends on.
RUN npm install --no-audit --no-fund --legacy-peer-deps \
  && npm --workspace @datafoundry/api run build \
  && npm prune --omit=dev

FROM node:22.21-bookworm-slim AS runtime
WORKDIR /repo

# Runtime needs python3 only for occasional native recompile and sqlite3 CLI for backups.
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 ca-certificates sqlite3 tini \
  && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
ENV PORT=8787
ENV NODE_OPTIONS="--enable-source-maps"

# Copy the pruned workspace from the builder.
COPY --from=builder /repo /repo

# Make a non-root user; the API reads/writes under DATA_DIR.
RUN useradd --create-home --shell /bin/bash node
USER node

# Persistent storage for sqlite, files, and mastra state.
ENV DATA_DIR=/data
VOLUME ["/data"]

EXPOSE 8787

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:' + (process.env.PORT || 8787) + '/api/v1/capabilities').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "apps/api/dist/index.js"]
