{
  "name": "@agentx/inngest-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Worker: worker.js (A8 dispatch) + subscribe_loop.js (A9 subscription match/deliver).",
  "type": "module",
  "main": "dist/worker.js",
  "bin": {
    "inngest-bridge": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --enable-source-maps dist/worker.js",
    "start:sub": "node --enable-source-maps dist/subscribe_loop.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "verify:loop": "tsc --noEmit && node dist/verify-loop.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
