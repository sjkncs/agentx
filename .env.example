API_HOST=127.0.0.1
API_PORT=8787
WEB_HOST=127.0.0.1
WEB_PORT=3000

# LLM_* values are optional server-side defaults. Models can also be created in the Web UI after deploy.
LLM_PROVIDER=openai-compatible
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=

# Optional Agent runtime limit overrides. Defaults and safe ranges are defined in
# packages/agent-runtime/src/config/agent-runtime-limits.ts.
# DATAFOUNDRY_AGENT_MAX_STEPS=80
# DATAFOUNDRY_SQL_MAX_EXECUTION_COUNT=60
# DATAFOUNDRY_DATA_ANALYSIS_MAX_PROTOCOL_ACTIONS=500
# DATAFOUNDRY_GENERAL_TASK_MAX_PROTOCOL_ACTIONS=100
# DATAFOUNDRY_PROTOCOL_DEFAULT_MAX_ACTIONS=100
# DATAFOUNDRY_PROTOCOL_MAX_COMPLETION_REJECTIONS=3
# DATAFOUNDRY_PROTOCOL_MAX_COMMIT_RETRIES=8
# DATAFOUNDRY_PROTOCOL_AUTOMATIC_ACTION_MAX_DEPTH=10
# DATAFOUNDRY_SCHEMA_MAX_TABLES=20
# DATAFOUNDRY_SCHEMA_MAX_COLUMNS_PER_TABLE=50
# DATAFOUNDRY_SQL_MAX_MODEL_ROWS=20
# DATAFOUNDRY_SQL_MAX_ACTIVITY_ROWS=20
# DATAFOUNDRY_SQL_MAX_CELL_CHARS=500
# DATAFOUNDRY_SQL_MAX_SQL_CHARS=4000
# DATAFOUNDRY_CONTEXT_MAX_TOKENS=32000
# DATAFOUNDRY_CONTEXT_MAX_CHARS=32000
# DATAFOUNDRY_TOOL_ERROR_MAX_MESSAGE_CHARS=500
# DATAFOUNDRY_KNOWLEDGE_MAX_TOP_K=20
# DATAFOUNDRY_REQUIREMENT_COMMIT_MAX_CLAIMS=16
# DATAFOUNDRY_REQUIREMENT_COMMIT_MAX_OUTPUT_FIELDS=32
# DATAFOUNDRY_MODEL_HELPER_MAX_STEPS=1
# DATAFOUNDRY_PROTOCOL_CLASSIFIER_MAX_OUTPUT_TOKENS=512
# DATAFOUNDRY_REQUIREMENT_EXTRACTOR_MAX_OUTPUT_TOKENS=4096
# DATAFOUNDRY_CONTRACT_GROUNDER_MAX_OUTPUT_TOKENS=8192
# DATAFOUNDRY_CONTRACT_GROUNDER_MAX_ATTEMPTS=2
# DATAFOUNDRY_TOOL_OBSERVATION_MAX_NAMES=5
# DATAFOUNDRY_TOOL_OBSERVATION_MAX_NAME_CHARS=120
# DATAFOUNDRY_TOOL_OBSERVATION_MAX_CHARS=12000

EMBEDDING_PROVIDER=bailian
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
EMBEDDING_OUTPUT_TYPE=dense
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=

# Agent execute_command sandbox: Python venv with numpy/pandas/matplotlib/scikit-learn.
# Default auto-detects repo `.venv` (also checks npm INIT_CWD). Override with absolute path:
# WORKSPACE_PYTHON_VENV=/path/to/DataFoundry/.venv
# WORKSPACE_COMMAND_TIMEOUT_MS=120000

STORAGE_ROOT_DIR=storage
METADATA_DB_PATH=storage/metadata/workbench.sqlite
SECRET_MASTER_KEY=replace-with-a-long-random-local-key

# ---------------------------------------------------------------------------
# Formal deploy (default): password + build/start. Do NOT use npm run dev here.
#
#
# Two formal environments share the same start commands; differ mainly here:
#
#   Formal test (local / private acceptance):
#     AUTH_PUBLIC_BASE_URL=http://127.0.0.1:3000
#     AUTH_EMAIL_DELIVERY=test          # verification links → API console
#
#   Real production (public service):
#     AUTH_PUBLIC_BASE_URL=https://datafoundry.example.com
#     AUTH_EMAIL_DELIVERY=smtp          # fill AUTH_SMTP_* below
#     + reverse proxy: deploy/nginx.datafoundry.conf.example
#
# ---------------------------------------------------------------------------
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
AUTH_PUBLIC_BASE_URL=http://127.0.0.1:3000
# Required in password mode (open|closed). open = self-register; closed = REGISTRATION_CLOSED.
# Exposed via GET /api/v1/auth/status (no secrets). Do not use AUTH_EMAIL_DELIVERY=test
# with a non-loopback AUTH_PUBLIC_BASE_URL.
AUTH_REGISTRATION_MODE=open
# Required when set: only smtp|test. test = log links to console; smtp = send real email.
AUTH_EMAIL_DELIVERY=test
AUTH_EMAIL_FROM=DataFoundry <no-reply@example.com>
AUTH_SMTP_HOST=smtp.example.com
AUTH_SMTP_PORT=587
AUTH_SMTP_SECURE=false
AUTH_SMTP_USER=
AUTH_SMTP_PASSWORD=

# Next.js BFF (apps/web) → API. Set this in apps/web/.env.local (not required in root .env).
# Used in password / formal mode when the browser calls same-origin `/api/v1/*` and `/api/copilotkit`.
# API_PROXY_TARGET=http://127.0.0.1:8787

SQL_DEFAULT_LIMIT=100
SQL_MAX_LIMIT=1000
SQL_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Supabase bridge (optional). When SUPABASE_URL + SUPABASE_SERVICE_KEY are
# set, the API mirrors runs/events/memories to the linked project.
# Project ref: YOUR_SUPABASE_PROJECT_REF. Schema is `datafoundry`.
# Get service_role key from Supabase Dashboard → Settings → API.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SCHEMA=datafoundry
DFD_EMBEDDING_DIM=1024

# ---------------------------------------------------------------------------
# Inngest Bridge Workers (services/inngest-bridge/src/)
#   subscribe_loop.ts  — 订阅投递 + A17 指数退避重试
#   verify-loop.ts     — SLA 超时监控
#   worker.ts          — Inngest event handler
#
# LOCAL DEV: use docker-compose.yml (ports 5432, 6379)
# In docker-compose: SUPABASE_URL=http://host.docker.internal:5432
#                   (connects directly to postgres, bypassing Supabase hosted)
# PRODUCTION: use real SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY above.
# ---------------------------------------------------------------------------
# INNGEST_SIGNING_KEY=           # Inngest Cloud signing key for webhook verification
# INNGEST_EVENT_KEY=             # Inngest event ingestion key

# ---------------------------------------------------------------------------
# DingTalk Integration
#   DINGTALK_ROBOT_SECRET — 群机器人签名密钥（HMAC-SHA256）
#   DINGTALK_APP_KEY / DINGTALK_APP_SECRET — 企业内部应用凭证（enterprise IM channel）
# ---------------------------------------------------------------------------
DINGTALK_ROBOT_SECRET=
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=

# ---------------------------------------------------------------------------
# Inngest Bridge Worker Env (subscribe_loop.ts)
# POLL_INTERVAL_MS=800         # poll frequency (ms)
# BATCH_SIZE=5                 # events per poll
# HTTP_TIMEOUT_MS=5000         # HTTP request timeout
# DRY_RUN=false                # set true to log without sending
# SUBSCRIBER_WORKSPACE_ID=default
# DISPATCHED_TO=subscriber
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Inngest Bridge Worker Env (verify-loop.ts)
# VERIFY_INTERVAL_MS=30000     # SLA check frequency
# DISPATCHED_TO=verifier
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# A17 Retry Backoff (per-channel overrides, defaults in 012_workspace_config.sql)
# RETRY_MULTIPLIER=2.0         # backoff multiplier
# RETRY_MAX_DELAY=3600          # max delay seconds (default 3600s = 1h)
# RETRY_MAX_DINGTALK=5         # max attempts for dingtalk channel
# RETRY_BASE_DINGTALK=30       # base delay seconds for dingtalk
# ---------------------------------------------------------------------------
