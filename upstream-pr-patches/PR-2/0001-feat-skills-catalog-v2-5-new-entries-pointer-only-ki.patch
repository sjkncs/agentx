 packages/skills/src/marketplace.ts         | 11 +++
 3 files changed, 127 insertions(+), 1 deletion(-)

diff --git a/apps/api/src/skill-marketplace.smoke.mjs b/apps/api/src/skill-marketplace.smoke.mjs
index ef1769e..644b0b2 100644
--- a/apps/api/src/skill-marketplace.smoke.mjs
+++ b/apps/api/src/skill-marketplace.smoke.mjs
@@ -52,9 +52,31 @@ setSkillCatalog(catalog);
 
 let okCount = 0;
 let failCount = 0;
+let pointerCount = 0;
 const failures = [];
 
 for (const entry of catalog) {
+  // External-pointer entries are discovery-only (npm libraries, Codex plugins,
+  // multi-skill bundles); they have no installable SKILL.md. Verify the raw
+  // URL responds 200 and skip the install round-trip.
+  if (entry.kind === "external-pointer") {
+    const url = `https://raw.githubusercontent.com/${entry.repo}/${entry.defaultRef}/${entry.skillPath}`;
+    try {
+      const head = await fetch(url, { method: "HEAD" });
+      if (!head.ok) {
+        failures.push(`${entry.id} (pointer): raw URL ${url} returned ${head.status}`);
+        failCount += 1;
+        continue;
+      }
+      console.log(`[smoke] ${entry.id} (pointer): raw URL OK (${head.status})`);
+      pointerCount += 1;
+      continue;
+    } catch (err) {
+      failures.push(`${entry.id} (pointer): ${err instanceof Error ? err.message : String(err)}`);
+      failCount += 1;
+      continue;
+    }
+  }
   try {
     const req = { method: "POST", configContext };
     const resp = await handleSkillMarketplaceRequest(req, "/api/v1/skill-marketplace/install", { id: entry.id });
@@ -90,7 +112,7 @@ try {
   // ignore
 }
 
-console.log(`\n[smoke] catalog=${catalog.length} ok=${okCount} fail=${failCount}`);
+console.log(`\n[smoke] catalog=${catalog.length} ok=${okCount} pointers=${pointerCount} fail=${failCount}`);
 if (failCount > 0) {
   console.error("[smoke] failures:");
   for (const f of failures) console.error("  -", f);
