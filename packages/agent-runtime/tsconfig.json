{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "paths": {
      "@agentx/agent-runtime": ["./src/index.ts"],
      "@agentx/agent-runtime/*": ["./src/*"]
    }
  },
  "references": [
    {
      "path": "../contracts"
    },
    {
      "path": "../artifacts"
    },
    {
      "path": "../data-gateway"
    },
    {
      "path": "../files"
    },
    {
      "path": "../skills"
    },
    {
      "path": "../providers"
    }
  ],
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist/**",
    "src/**/*.test.ts",
    "src/**/__tests__/**"
  ]
}