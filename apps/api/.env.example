# AgentX Environment Configuration
# Copy to .env.local and fill in real values.
# ---------------------------------------------------------------------------
# LLM API (gpt-5.5-openai-compact / server-default)
# ---------------------------------------------------------------------------
# These 4 variables are REQUIRED for the server-default LLM profile.
# If a saved model-profile in the metadata store has a secret_ref with a
# valid apiKey, the per-profile credentials take priority.

# OpenAI-compatible provider (default: openai-compatible)
# https://api.openai.com/v1     (OpenAI)
# https://dashscope.aliyuncs.com/compatible-mode/v1  (Aliyun Bailian qwen)
# https://api.deepseek.com/v1   (DeepSeek)
LLM_PROVIDER=openai-compatible

# Chat model name (Qwen Plus default).
# For gpt-5.5-openai-compact, set this to match the actual model your
# provider serves — the 'compact' suffix is a AgentX label, not the
# upstream model name.
LLM_MODEL=gpt-5.5-openai-compact

# OpenAI-compatible base URL
LLM_BASE_URL=https://api.openai.com/v1

# Chat API key (NO quotes)
LLM_API_KEY=sk-replace-with-your-real-key

# Total context window used for prompt budget planning
AGENT_MODEL_CONTEXT_WINDOW=128000

# ---------------------------------------------------------------------------
# Embedding API (used for semantic memory / long-term memory)
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=bailian
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=sk-replace-with-your-real-key
EMBEDDING_DIM=1024

# ---------------------------------------------------------------------------
# Auth (required for /api/v1/* endpoints)
# ---------------------------------------------------------------------------
AUTH_PUBLIC_BASE_URL=http://127.0.0.1:3000
AUTH_REGISTRATION_MODE=open
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
AUTH_EMAIL_DELIVERY=test

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
STORAGE_ROOT_DIR=./storage
SECRET_MASTER_KEY=replace-with-at-least-32-random-characters

# ---------------------------------------------------------------------------
# Supabase (for @agentx/supabase-bridge — sessions, memory, etc.)
# ---------------------------------------------------------------------------
# Project: https://supabase.com/dashboard/project/YOUR_PROJECT_REF
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=replace-with-your-supabase-service-role-key
SUPABASE_SCHEMA=agentx
DFD_EMBEDDING_DIM=1024
